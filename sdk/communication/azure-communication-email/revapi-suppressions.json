[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "code": "java.method.varargOverloadsOnlyDifferInVarargParameter",
          "old": {
            "matcher": "regex",
            "match": "method com\\.azure\\.communication\\.email\\.models\\.EmailMessage com\\.azure\\.communication\\.email\\.models\\.EmailMessage::set(Cc|Bcc|To)Recipients.*"
          }
        }
      ]
    }
  }
]
