[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "code": "java.class.nonPublicPartOfAPI",
          "new": {
            "matcher": "regex",
            "match": "(class|interface) com\\.azure\\.keyvault\\.jca\\.(com|org)\\..*"
          },
          "justification": "skip check for third party files."
        },
        {
          "code": "java.class.nonPublicPartOfAPI",
          "new": {
            "matcher": "regex",
            "match": "(class|enum|interface) org\\.conscrypt\\..*"
          },
          "justification": "skip check for third party files."
        }
      ]
    }
  }
]
