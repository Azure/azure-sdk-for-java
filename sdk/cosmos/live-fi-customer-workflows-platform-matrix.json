        "MultiMaster_MultiRegion_FI_CustomerWorkflows": {
          "ArmTemplateParameters": "@{ enableMultipleWriteLocations = $true; defaultConsistencyLevel = 'Session'; enableMultipleRegions = $true }",
          "PREFERRED_LOCATIONS": "[\"East US 2\"]"
        }
      },
      "PROTOCOLS": "[\"Tcp\"]",
