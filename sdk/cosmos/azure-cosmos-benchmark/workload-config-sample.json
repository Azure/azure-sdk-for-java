{
  "lifecycle": {
    "cycles": 1,
    "settleTimeMs": -1,
    "suppressCleanup": false,
    "gcBetweenCycles": true
  },

  "orchestrator": {
    "concurrency": 1000,
    "numberOfOperations": 100000,
    "isPartitionLevelCircuitBreakerEnabled": true,
    "isPerPartitionAutomaticFailoverRequired": true,
    "minConnectionPoolSizePerEndpoint": 0,

    "metrics": {
      "printingInterval": 10,
      "enableJvmStats": true,
      "enableNettyHttpMetrics": true,
      "destination": {
        "cosmos": {
          "serviceEndpoint": "https://gatewayv2-scale-test.documents.azure.com:443/",
          "masterKey": "<your-metrics-account-key>",
          "database": "benchmarkdb",
          "container": "cosmosbenchmarkmetricsfeed",
          "testVariationName": "container-fault-injection",
          "branchName": "<your-branch>",
          "commitId": "<your-commit>"
        }
      }
    },

    "tenantDefaults": {
      "consistencyLevel": "Session",
      "connectionMode": "Direct",
      "numberOfPreCreatedDocuments": 1000,
      "documentDataFieldSize": 20,
      "faultInjection": {
        "serverErrorType": "SERVICE_UNAVAILABLE",
        "region": "West US",
        "startDelay": "PT30S",
        "duration": "PT30S",
        "injectionRate": 1.0
      }
    },

    "tenants": [
      {
        "serviceEndpoint": "https://myaccount.documents.azure.com:443/",
        "masterKey": "<your-master-key>",
        "databaseId": "benchdb",
        "containerId": "benchcoll",
        "operation": "ReadThroughput"
      }
    ]
  }
}
