[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "regex": true,
          "code": "java.method.(returnTypeTypeParametersChanged|parameterTypeChanged|returnTypeChanged)",
          "new": ".* com.azure.security.attestation.*attestTpm.*"
        }
      ]
    }
  },
  {
    "extension": "ignored-jackson-databind-removal",
    "id": "sdk-jackson-removal",
    "configuration": {
      "enabled": true,
      "ignoredPackages": {
        "com.azure.security.": [
          "attestation.models"
        ]
      }
    }
  }
]
