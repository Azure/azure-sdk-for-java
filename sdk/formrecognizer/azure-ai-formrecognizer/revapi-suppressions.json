[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "code": "java.annotation.added",
          "new": {
            "matcher": "regex",
            "match": "class com.azure.ai.formrecognizer.documentanalysis.models.(DocumentField|DocumentLine)"
          },
          "justification": "Skip customized getters on class when serialization and deserialization."
        }
      ]
    }
  },
  {
    "extension": "ignored-jackson-databind-removal",
    "id": "sdk-jackson-removal",
    "configuration": {
      "enabled": true,
      "ignoredPackages": {
        "com.azure.ai.": [
          "formrecognizer.documentanalysis.models",
          "formrecognizer.documentanalysis.administration.models",
          "formrecognizer.models",
          "formrecognizer.training.models"
        ]
      }
    }
  }
]
