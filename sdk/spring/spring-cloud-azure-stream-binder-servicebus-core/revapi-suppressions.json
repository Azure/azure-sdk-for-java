[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "code": "java.class.externalClassExposedInAPI",
          "new": {
            "matcher": "regex",
            "match": "class com.azure.spring.cloud.stream.binder.servicebus.core.properties.(ServiceBusProducerProperties|ServiceBusConsumerProperties)"
          },
          "justification": "Support new properties."
        },
        {
          "code": "java.class.externalClassExposedInAPI",
          "new": {
            "matcher": "regex",
            "match": "class com.azure.spring.cloud.stream.binder.servicebus.core.properties.(ServiceBusProducerProperties|ServiceBusConsumerProperties)"
          },
          "justification": "Support new properties."
        }
      ]
    }
  }
]
