[
  {
    "extension": "revapi.differences",
    "id": "sdk-suppressions",
    "configuration": {
      "ignore": true,
      "differences": [
        {
          "code": "java.method.removed",
          "old": {
            "matcher": "regex",
            "match": "method java\\.lang\\.String com\\.azure\\.spring\\.cloud\\.autoconfigure\\.jms\\.properties\\.AzureServiceBusJmsProperties::get(Password|RemoteUrl|Username)\\(\\)"
          },
          "justification": "Remove some meaningless jms properties"
        },
        {
          "code": "java.method.removed",
          "old": {
            "matcher": "regex",
            "match": "method void com\\.azure\\.spring\\.cloud\\.autoconfigure\\.jms\\.properties\\.AzureServiceBusJmsProperties::set(Password|RemoteUrl|Username)\\(java\\.lang\\.String\\)"
          },
          "justification": "Remove some meaningless jms properties"
        },
        {
          "code": "java.class.removed",
          "old": "interface com.azure.spring.cloud.autoconfigure.jms.ServiceBusJmsConnectionFactoryCustomizer",
          "justification": "Remove deprecated method"
        }
      ]
    }
  }
]
