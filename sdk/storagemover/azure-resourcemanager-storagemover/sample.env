# Playback ignores these live-only fixture overrides and needs no credentials.
AZURE_TEST_MODE=PLAYBACK

# Set for LIVE/RECORD using an Azure CLI login with access to the test subscription.
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
STORAGEMOVER_SYNTHETICS_SUBSCRIPTION_ID=

# Optional default region; shared S3 fixtures remain in westcentralus.
STORAGE_MOVER_TEST_LOCATION=

# Optional overrides for the existing shared PLS; do not recreate or delete it.
STORAGE_MOVER_PRIVATE_LINK_SERVICE_RESOURCE_GROUP=E2E-Management-RGsyn
STORAGE_MOVER_PRIVATE_LINK_SERVICE_NAME=test-pls-wcs
