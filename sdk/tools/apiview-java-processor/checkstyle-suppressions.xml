<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- This command-line tool exposes parser ASTs and uses console output, not client-library logging. -->
  <suppress
      checks="io\.clientcore\.linting\.extensions\.checkstyle\.checks\.(ExternalDependencyExposedCheck|GoodLoggingCheck|ThrowFromClientLoggerCheck)"
      files="[/\\]src[/\\]main[/\\]java[/\\]com[/\\]azure[/\\]tools[/\\]apiview[/\\].*\.java"/>
  <!-- These APIView models are serialized output, not SDK request/response models. -->
  <suppress
      checks="io\.clientcore\.linting\.extensions\.checkstyle\.checks\.SerializableMethodsCheck"
      files="[/\\]processor[/\\]model[/\\](ApiListing|ReviewLine|ReviewToken)\.java"/>
</suppressions>
