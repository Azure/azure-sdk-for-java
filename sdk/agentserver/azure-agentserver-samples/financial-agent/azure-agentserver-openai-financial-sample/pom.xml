<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.microsoft.agentserver</groupId>
    <artifactId>azure-agentserver-samples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>azure-agentserver-openai-financial-sample</artifactId>
  <name>azure-agentserver-openai-financial-sample</name>
  <description>Framework-free financial agent — a hand-written, LLM-driven tool-calling loop over the raw OpenAI Java SDK, demonstrating agentic behaviour without an agent framework such as langchain4j</description>

  <dependencies>
    <!-- Agent Server API and Jersey runtime -->
    <dependency>
      <groupId>com.microsoft.agentserver</groupId>
      <artifactId>azure-agentserver-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.agentserver</groupId>
      <artifactId>azure-agentserver-api-jaxrs</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.agentserver</groupId>
      <artifactId>azure-agentserver-jersey</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- OpenAI Java SDK (stainless-generated) — OkHttp client brings in openai-java-core transitively -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-client-okhttp</artifactId>
      <scope>compile</scope>
    </dependency>

    <!-- SLF4J runtime binding so framework logs are visible -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${maven-assembly-plugin.version}</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.microsoft.agentserver.sample.financial.openai.Main</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
