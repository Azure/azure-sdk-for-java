<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.microsoft.agentserver</groupId>
    <artifactId>azure-agentserver-samples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>azure-agentserver-hosted-agent-cli</artifactId>
  <name>azure-agentserver-hosted-agent-cli</name>
  <description>Command-line hosted-agent deployment tool for Azure AI Foundry (vnext). Deploys, inspects, lists,
    deletes and streams logs for container-based hosted agents using the com.azure:azure-ai-agents Java SDK.</description>

  <properties>
    <!--
      azure-ai-agents 2.2.0 is compiled against openai-java 4.14.0. The agentserver parent manages
      openai-java to a newer version, so pin the matching version here (a direct dependency with an
      explicit version overrides the parent dependencyManagement) to avoid binary incompatibilities.
    -->
    <azure-ai-agents.version>2.2.0</azure-ai-agents.version>
    <sample-openai.version>4.50.0</sample-openai.version>
    <azure-core-http-okhttp.version>1.13.5</azure-core-http-okhttp.version>
    <azure-resourcemanager-authorization.version>2.53.9</azure-resourcemanager-authorization.version>
    <azure-resourcemanager-cognitiveservices.version>1.4.0</azure-resourcemanager-cognitiveservices.version>
    <azure-monitor-query.version>1.5.9</azure-monitor-query.version>
  </properties>

  <dependencies>
    <!-- Command-line argument parsing (annotation-based); already used by the perf/benchmark tooling. -->
    <dependency>
      <groupId>com.beust</groupId>
      <artifactId>jcommander</artifactId>
      <version>1.82</version>
    </dependency>

    <!-- Azure AI Agents SDK: the entire vnext hosted-agent surface (deploy, status, list, delete, logs) -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-ai-agents</artifactId>
      <version>${azure-ai-agents.version}</version>
      <exclusions>
        <!-- Use the OkHttp-based Azure HTTP client instead of Netty (see azure-core-http-okhttp below) -->
        <exclusion>
          <groupId>com.azure</groupId>
          <artifactId>azure-core-http-netty</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- OkHttp implementation of the Azure core HTTP client -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-core-http-okhttp</artifactId>
      <version>${azure-core-http-okhttp.version}</version>
    </dependency>

    <!-- Credential used to authenticate to the Foundry project -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-identity</artifactId>
    </dependency>

    <!-- Azure Resource Manager SDKs used to verify, at deploy time, that the agent's managed identity has
         been granted the Azure OpenAI data-plane role on the AI Services account (no shelling out to az). -->
    <dependency>
      <groupId>com.azure.resourcemanager</groupId>
      <artifactId>azure-resourcemanager-authorization</artifactId>
      <version>${azure-resourcemanager-authorization.version}</version>
    </dependency>
    <dependency>
      <groupId>com.azure.resourcemanager</groupId>
      <artifactId>azure-resourcemanager-cognitiveservices</artifactId>
      <version>${azure-resourcemanager-cognitiveservices.version}</version>
    </dependency>

    <!-- Query Application Insights history for a deployed agent (the insights log source). -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-monitor-query</artifactId>
      <version>${azure-monitor-query.version}</version>
    </dependency>

    <!-- Pin the OpenAI Java SDK version that azure-ai-agents 2.2.0 was built against -->
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java</artifactId>
      <version>${sample-openai.version}</version>
    </dependency>

    <!-- Jackson datatype modules required by the OpenAI Java SDK's object mapper -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jdk8</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- YAML config file support for CLI arguments -->
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- SLF4J runtime binding so SDK logs are visible -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${maven-assembly-plugin.version}</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.microsoft.agentserver.hostedagent.cli.HostedAgentCli</mainClass>
            </manifest>
          </archive>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
