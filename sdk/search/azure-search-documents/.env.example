# Copy this file to .env beside Set-TestEnvironment.ps1. .env is git-ignored.
# Values are literal; no PowerShell syntax, interpolation, or inline comments.
# Existing $env: variables win unless -OverwriteExisting is specified.
# Fill in only the resources used by the tests you choose to run.

AZURE_TEST_MODE=PLAYBACK

# Search: required for RECORD/LIVE. This is NOT the samples' SEARCH_ENDPOINT.
SEARCH_SERVICE_ENDPOINT=

# RECORD/LIVE run locally using your az login identity and its Search RBAC roles.
# No keys or client secrets are needed. No managed identity is required on your computer.
# The Search service uses its own system-assigned identity and RBAC for outbound resources.

# OpenAI: model-backed knowledge retrieval.
SEARCH_OPENAI_ENDPOINT=
SEARCH_OPENAI_DEPLOYMENT_NAME=
SEARCH_OPENAI_MODEL_NAME=

# Embeddings: file/indexed knowledge source ingestion.
# Uses SEARCH_OPENAI_ENDPOINT above; deployments must already exist.
SEARCH_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
SEARCH_OPENAI_EMBEDDING_MODEL_NAME=

# Storage: Blob-backed tests construct a ResourceId connection string.
SEARCH_STORAGE_ACCOUNT_NAME=
SEARCH_STORAGE_CONTAINER_NAME=
SEARCH_SUBSCRIPTION_ID=
SEARCH_RESOURCE_GROUP=

# AiServices: standard extraction and Content Understanding skillset billing.
# Search authenticates with its system-assigned identity; no API key is needed.
SEARCH_AI_SERVICES_ENDPOINT=
